# Copy to .env.local to run locally. In Vercel these go on Production only —
# there is no Preview or Development environment for this project.

# WhatsApp target for the "message her on WhatsApp" link in the page header.
# Accepts either a phone number in any formatting (the digits are extracted and
# turned into https://wa.me/<digits>) or a full URL:
#
#   NEXT_PUBLIC_FEEDBACK_WHATSAPP="+359 88 123 4567"
#   NEXT_PUBLIC_FEEDBACK_WHATSAPP="https://wa.me/359881234567"
#   NEXT_PUBLIC_FEEDBACK_WHATSAPP="https://chat.whatsapp.com/AbCdEf123"
#
# NEXT_PUBLIC_ means the value is inlined into the page and visible to every
# visitor — that's inherent to a public contact link, but prefer a group invite
# link over a personal number if you'd rather not publish the number itself.
# Unset, the header still names the maintainer but renders no link.
NEXT_PUBLIC_FEEDBACK_WHATSAPP=

# Set by the Vercel Blob integration; used to read the pushed stats/events/rentals.
BLOB_READ_WRITE_TOKEN=

# Bearer tokens the VPS uses to push. Must match the values in events.env on the VPS.
STATS_PUSH_TOKEN=
EVENTS_PUSH_TOKEN=
RENTALS_PUSH_TOKEN=
